# Copy to .env and fill in. .env is gitignored and must never be committed.

# Needed for the gated repositories (Llama 3.1, Mistral). Read access is enough.
HF_TOKEN=

# Optional: move the weight cache onto the pod's large volume instead of the boot disk.
HF_HOME=

# Optional overrides, both have defaults in pilot/config.py
PILOT_DATASET=
PILOT_SPLIT=
